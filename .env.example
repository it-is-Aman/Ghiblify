# Clerk authentication (https://dashboard.clerk.com -> API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/signin
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup

# Cloudflare Workers AI (free: 10,000 neurons/day, no credit card)
# Account ID: Cloudflare dashboard -> Workers & Pages (right sidebar)
# API token: My Profile -> API Tokens -> Create Token -> "Workers AI" template
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional: free conversions per signed-in user per day (default 10)
DAILY_LIMIT=10
